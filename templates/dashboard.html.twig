<div class="p-3">
    <p>Review your pending publications, visibility changes, failures, and audit history.</p>
    <ul>
        {% for row in rows %}<li><a href="{{ path('wizhippo_schedule_detail', {id: row.id}) }}">{{ row.content_name }} — {{ row.action }}</a> · {{ row.run_at|date('Y-m-d H:i P', row.timezone) }} ({{ row.timezone }})</li>
        {% else %}<li>No accessible pending schedules on this page.</li>{% endfor %}
    </ul>
    <a class="btn ibexa-btn ibexa-btn--secondary" href="{{ path('wizhippo_schedule_list', {mine: 1}) }}">My scheduled content</a>
</div>
