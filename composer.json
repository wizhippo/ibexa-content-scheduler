{
    "name": "wizhippo/ibexa-content-scheduler",
    "description": "Independent scheduled publication and visibility management for the Ibexa 5 admin UI.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-only",
    "require": {
        "doctrine/dbal": "^3.10",
        "ibexa/admin-ui": "^5.0",
        "ibexa/content-forms": "^5.0",
        "ibexa/core": "^5.0",
        "knplabs/knp-menu": "^3.0",
        "php": ">=8.4",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/clock": "^7.4",
        "symfony/console": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Wizhippo\\IbexaContentScheduler\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Douglas Hammond",
            "homepage": "https://github.com/wizhippo",
            "role": "Author and maintainer"
        },
        {
            "name": "LLM",
            "role": "AI-assisted development"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Wizhippo\\IbexaContentScheduler\\Tests\\": "tests/"
        }
    }
}
